# Template for a target directory's `.env` — the per-target config the loop and
# the target's docker-compose.yml read.
#
# A target lives OUTSIDE the coder repo: a directory (e.g. `~/coder/nikos/`)
# holding a `docker-compose.yml` and this `.env`. `setup/setup-env.sh <dir>`
# writes both for you; copying them by hand works too. The directory name becomes
# the Compose project name, so keep it a clean lowercase slug.
#
# Anything you leave unset falls back to the loop's built-in defaults (shown
# below). Secrets live here, outside version control — keep the file owner-only.

# --- Required ---

# Git remote URL of the target repo (whose kanban-board/02-refined column the
# loop drains).
TARGET_REPO=https://github.com/you/your-repo.git

# Claude subscription token from `claude setup-token` (NOT an ANTHROPIC_API_KEY).
CLAUDE_CODE_OAUTH_TOKEN=

# Scoped HTTPS Personal Access Token for the target repo (used for pull/push).
GIT_PAT=

# --- Optional (defaults shown; uncomment to override) ---

# Branch to work on.
#TARGET_BRANCH=main

# Username paired with GIT_PAT (GitHub accepts x-access-token for token auth).
#GIT_USERNAME=x-access-token

# Committer identity for the commits /implement makes in the target repo.
#GIT_USER_NAME=coder (autonomous loop)
#GIT_USER_EMAIL=coder@autonomous-loop

# Loop tuning (see README for meanings).
#WORK_SLEEP=5
#IDLE_SLEEP=60
#MAX_RETRIES=3
#RUN_TIMEOUT=30m
#RUN_KILL_AFTER=30s
#MAX_ITERATIONS=
